<Window x:Class="TangSpeedtest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="Speed Test"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="640"
        Width="740"
        MinHeight="540"
        MinWidth="580"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="{StaticResource Win11.BackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Download Speed Test"
                   FontSize="28"
                   FontWeight="SemiBold"
                   FontFamily="Segoe UI Variable Display, Segoe UI"
                   Foreground="{StaticResource Win11.TextPrimaryBrush}"/>

        <TextBlock Grid.Row="1"
                   Margin="0,6,0,0"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource Win11.TextSecondaryBrush}"
                   FontSize="13"/>

        <!-- Metrics card -->
        <Border Grid.Row="2"
                Margin="0,20,0,0"
                Style="{StaticResource Win11Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Current speed"
                               Foreground="{StaticResource Win11.TextTertiaryBrush}"
                               FontSize="12"/>
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding CurrentSpeedText}"
                               FontSize="28"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               Foreground="{StaticResource Win11.AccentBrush}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1">
                    <TextBlock Text="Average speed"
                               Foreground="{StaticResource Win11.TextTertiaryBrush}"
                               FontSize="12"/>
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding AverageSpeedText}"
                               FontSize="28"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               Foreground="{StaticResource Win11.SuccessBrush}"/>
                </StackPanel>

                <ProgressBar Grid.Row="1"
                             Grid.ColumnSpan="2"
                             Margin="0,20,0,0"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding ProgressPercent}"
                             Style="{StaticResource Win11ProgressBar}"/>

                <TextBlock Grid.Row="2"
                           Grid.ColumnSpan="2"
                           Margin="0,14,0,0"
                           Text="{Binding LastResultText}"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Foreground="{StaticResource Win11.TextSecondaryBrush}"/>
            </Grid>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="3"
                    Margin="0,20,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left">
            <Button Content="Start Test"
                    Margin="0,0,10,0"
                    Command="{Binding StartTestCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Win11PrimaryButton}">
                        <Setter Property="IsEnabled" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Cancel"
                    Command="{Binding CancelTestCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Win11SecondaryButton}">
                        <Setter Property="IsEnabled" Value="False"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="IsEnabled" Value="True"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- Chart card -->
        <Border Grid.Row="4"
                Margin="0,20,0,0"
                Style="{StaticResource Win11Card}"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="4,0,4,10">
                    <Button DockPanel.Dock="Right"
                            Content="Clear history"
                            Style="{StaticResource Win11SubtleButton}"
                            Command="{Binding ClearHistoryCommand}"/>
                    <TextBlock Text="Last 10 average speeds (MB/s)"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="{StaticResource Win11.TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <lvc:CartesianChart Grid.Row="1"
                                    Series="{Binding ChartSeries}"
                                    XAxes="{Binding XAxes}"
                                    YAxes="{Binding YAxes}"
                                    TooltipPosition="Top"
                                    MinHeight="220"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="5"
                   Margin="0,14,0,0"
                   HorizontalAlignment="Right"
                   FontSize="11"
                   Foreground="{StaticResource Win11.TextTertiaryBrush}"
                   Text="3 parallel connections · 2s warmup excluded · 10s measure · speedtest.360.cn/16m"/>
    </Grid>
</Window>
