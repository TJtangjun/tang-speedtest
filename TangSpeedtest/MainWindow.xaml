<Window x:Class="TangSpeedtest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="网速测试"
        Height="620"
        Width="720"
        MinHeight="520"
        MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="下载测速"
                   FontSize="28"
                   FontWeight="SemiBold"
                   Foreground="#1A1A2E"/>

        <TextBlock Grid.Row="1"
                   Margin="0,8,0,0"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   Foreground="#4A5568"
                   FontSize="14"/>

        <Border Grid.Row="2"
                Margin="0,20,0,0"
                Padding="20"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E2E8F0"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="当前速度" Foreground="#718096" FontSize="12"/>
                    <TextBlock Text="{Binding CurrentSpeedText}"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#2B6CB0"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1">
                    <TextBlock Text="平均速度" Foreground="#718096" FontSize="12"/>
                    <TextBlock Text="{Binding AverageSpeedText}"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#2F855A"/>
                </StackPanel>

                <ProgressBar Grid.Row="1"
                             Grid.ColumnSpan="2"
                             Margin="0,16,0,0"
                             Height="10"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding ProgressPercent}"/>

                <TextBlock Grid.Row="2"
                           Grid.ColumnSpan="2"
                           Margin="0,12,0,0"
                           Text="{Binding LastResultText}"
                           TextWrapping="Wrap"
                           Foreground="#2D3748"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3"
                    Margin="0,20,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left">
            <Button Content="开始测试"
                    Width="120"
                    Height="40"
                    Margin="0,0,12,0"
                    FontSize="14"
                    Command="{Binding StartTestCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="IsEnabled" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="取消"
                    Width="100"
                    Height="40"
                    FontSize="14"
                    Command="{Binding CancelTestCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="IsEnabled" Value="False"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="IsEnabled" Value="True"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <Border Grid.Row="4"
                Margin="0,20,0,0"
                Padding="12"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E2E8F0"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="4,4,4,8">
                    <Button DockPanel.Dock="Right"
                            Content="清除历史"
                            MinWidth="88"
                            Height="32"
                            Padding="12,0"
                            FontSize="13"
                            Command="{Binding ClearHistoryCommand}"/>
                    <TextBlock Text="最近 10 次平均速度（MB/s）"
                               FontWeight="SemiBold"
                               Foreground="#2D3748"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <lvc:CartesianChart Grid.Row="1"
                                    Series="{Binding ChartSeries}"
                                    XAxes="{Binding XAxes}"
                                    YAxes="{Binding YAxes}"
                                    TooltipPosition="Top"
                                    MinHeight="220"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="5"
                   Margin="0,12,0,0"
                   HorizontalAlignment="Right"
                   FontSize="11"
                   Foreground="#A0AEC0"
                   Text="3 条连接并行 · 预热 2 秒不计成绩 · 测量 10 秒 · speedtest.360.cn/16m"/>
    </Grid>
</Window>
